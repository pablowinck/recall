{
  "name": "@recall/domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --out-dir dist --watch"
  },
  "dependencies": {
    "ts-fsrs": "5.4.2",
    "@recall/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
