{
  "name": "@recall/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "tsup src/server.ts src/local.ts --format esm --out-dir dist --no-splitting",
    "start": "node dist/local.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "@supabase/supabase-js": "2.116.0",
    "@recall/contracts": "workspace:*",
    "@recall/domain": "workspace:*",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
